Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Points
      Enabled: true
      Topic:
        Value: /points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Position Transformer: XYZ
      Size (m): 0.02
      Style: Flat Squares
    - Class: rviz_default_plugins/PointCloud2
      Name: FusedMap
      Enabled: true
      Topic:
        Value: /map_points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Position Transformer: XYZ
      Size (m): 0.02
      Style: Flat Squares
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Pitch: 0.4
      Yaw: 3.4
      Focal Point:
        X: 1
        Y: 0
        Z: 0.5
