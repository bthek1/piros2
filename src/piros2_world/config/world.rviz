Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Depth3D
      Enabled: true
      Topic:
        Value: /points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Position Transformer: XYZ
      Size (m): 0.01
      Style: Flat Squares
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: CloudMap
      Enabled: true
      Topic:
        Value: /world/map_points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Position Transformer: XYZ
      Size (m): 0.02
      Style: Flat Squares
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: FusedMesh
      Enabled: true
      Topic:
        Value: /world/mesh
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /image_raw/compressed
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Keypoints
      Enabled: true
      Topic:
        Value: /keypoints/compressed
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: DepthPreview
      Enabled: true
      Topic:
        Value: /depth/preview/compressed
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Stats
      Enabled: true
      Topic:
        Value: /world/stats/compressed
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.4
    Saved: ~
Window Geometry:
  Camera:
    collapsed: false
  DepthPreview:
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Keypoints:
    collapsed: false
  Stats:
    collapsed: false
  Views:
    collapsed: false
  Width: 1400
  X: 60
  Y: 60
