# Environment for VSCode's Python test runner (see python.envFile in
# settings.json). The Testing sidebar spawns pytest WITHOUT a login shell, so
# none of ~/.profile's ROS setup applies — this file supplies the minimum for
# ament_* linters and rclpy to import.
PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages
LD_LIBRARY_PATH=/opt/ros/jazzy/lib
AMENT_PREFIX_PATH=/opt/ros/jazzy
